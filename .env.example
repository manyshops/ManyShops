# Canonical origin — drives metadata, hreflang, sitemap and JSON-LD @ids.
NEXT_PUBLIC_SITE_URL=https://manyshops.com

# WhatsApp number that receives orders. Digits only, country code included, no "+".
# Leave unset and the success screen simply omits the WhatsApp button.
NEXT_PUBLIC_WHATSAPP_NUMBER=9613000000

# Optional. When set, Claude refines the shipping-weight estimate for listings
# that publish no weight. Without it the keyword classifier handles every quote.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Scraping ---------------------------------------------------------------
# Every quote first tries a plain, header-spoofed fetch, which is free and works
# on most Turkish stores. The settings below only come into play when a store
# blocks that (Trendyol and Hepsiburada do). Leave SCRAPER_API_KEY unset and the
# app still works — blocked stores just fall through to manual price entry.
SCRAPER_API_KEY=

# Proxy exit country. Turkish storefronts geo-redirect foreign IPs to their
# homepage, so this must stay `tr` for them. Set to `none` to disable.
SCRAPER_API_COUNTRY=tr

# Proxy attempts per quote. Each attempt draws a fresh IP, which is what
# recovers the stores that bounce a subset of proxy addresses.
SCRAPER_API_MAX_ATTEMPTS=2

# auto  — direct first, proxy only if it fails (default; cheapest)
# always — skip the direct attempt entirely
# off   — never use the proxy
SCRAPER_API_MODE=auto

# Runs the target page in a real browser. Roughly 8x slower and costs more
# credits; not needed for the Turkish stores tested so far.
SCRAPER_API_RENDER=false
SCRAPER_API_PREMIUM=false
